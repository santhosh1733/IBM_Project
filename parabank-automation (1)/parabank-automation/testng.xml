<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<!--
  Main TestNG suite. parallel="classes" runs each <class> in its own thread,
  which works well here because DriverFactory uses ThreadLocal<WebDriver> --
  every module gets its own isolated browser session.

  thread-count controls how many classes run simultaneously. Keep this <=
  your team size / CI runner's CPU capacity; going too high just causes
  resource contention and flaky timeouts, not faster runs.
-->
<suite name="ParaBank UI Automation Suite" parallel="classes" thread-count="3" verbose="1">

    <!--
      TestListener wires every @Test's start/pass/fail/skip into ExtentReports
      (see com.parabank.listeners.TestListener + ExtentManager) and captures a
      screenshot into the report automatically on failure. Registering it here
      at suite level means individual test classes don't need @Listeners
      annotations -- it applies to every <class> below.
    -->
    <listeners>
        <listener class-name="com.parabank.listeners.TestListener"/>
    </listeners>

    <test name="ParaBank Full Regression">
        <classes>
            <class name="com.parabank.tests.LoginTest"/>
            <class name="com.parabank.tests.AccountOverviewTest"/>
            <class name="com.parabank.tests.TransferFundsTest"/>
            <class name="com.parabank.tests.BillPayTest"/>
            <class name="com.parabank.tests.FindTransactionsTest"/>
            <class name="com.parabank.tests.UpdateContactInfoTest"/>
            <class name="com.parabank.tests.RequestLoanTest"/>
        </classes>
    </test>

    <!--
      Team members: you can run just your own module in isolation while
      developing, e.g.:
        mvn test -Dtest=RequestLoanTest
      or create a per-module suite XML (see /suites folder) and point
      surefire at it temporarily.
    -->

</suite>
